---
layout: base
---
{{~ include "_i18n-detect" ~}}
<div class="row justify-content-center">
  <div class="col-md-12 col-lg-10 col-xl-8">
    <article>
      <h1>{{ page.title }}</h1>
      <ul>
        {{~ for item in page.pages.by_name ~}}
        <li><a href="{{ item.relative_url }}">{{ item.title }}</a></li>
        {{~ end ~}}
      </ul>
    </article>
  </div>
</div>