---
layout: base
---
{{~ include "_i18n-detect" ~}}
<div class="row flex-xl-nowrap">
  <div class="col-12 col-lg-3 col-xl-3 docs-sidebar d-none d-lg-block">
    <nav class="docs-links" aria-label="Docs">
      {{ include "sidebar/docs-menu" }}
    </nav>
  </div>
  {{~ if page.toc != false ~}}
  <nav class="docs-toc d-none d-xl-block col-xl-2" aria-label="On this page">
    {{ include "sidebar/docs-toc" }}
  </nav>
  {{~ end ~}}
  <main class="docs-content col-12 col-lg-9{{ if page.toc != false }} col-xl-7{{ else }} col-xl-9{{ end }}">
    <h1>{{ page.title }}</h1>
    {{~ if page.toc != false ~}}
    <nav class="d-xl-none docs-toc-mobile mb-3" aria-label="On this page">
      {{ include "sidebar/docs-toc" }}
    </nav>
    {{~ end ~}}
{{## content at column 0 so multi-line <pre> is not re-indented ##}}
{{ content }}
  </main>
</div>
