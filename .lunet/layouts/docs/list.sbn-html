---
layout: base
---
{{~ include "_i18n-detect" ~}}
<div class="row flex-xl-nowrap">
  <div class="col-12 col-lg-3 col-xl-3 docs-sidebar d-none d-lg-block">
    <nav class="docs-links" aria-label="Docs">
      {{ include "sidebar/docs-menu" }}
    </nav>
  </div>
  <main class="docs-content col-12 col-lg-9 col-xl-9">
    <h1>{{ page.title }}</h1>
{{ content }}
  </main>
</div>
