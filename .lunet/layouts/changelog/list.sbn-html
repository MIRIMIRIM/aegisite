{{~ include "_i18n-detect" ~}}
{{~ list_pages = page.pages != null ? page.pages.by_date.reverse : site.pages.by_date.reverse ~}}
{{~ body_class = page.section + " list" ~}}
{{~ lang_prefix = current_lang == "en" ? "/changelog/" : "/" + current_lang + "/changelog/" ~}}
{{~# release (default) vs beta — set on list index front matter ~}}
{{~ list_channel = page.channel ?? "release" ~}}
<!doctype html>
<html lang="{{ i18n.language_tag }}">
{{ include "head/head" }}
<body class="{{ body_class }}">
  {{ include "header/header" }}
  <div class="wrap container-{{ site.full_width ? "fluid" : "xxl" }}" role="document">
    <div class="content">
      <div class="row justify-content-center">
        <div class="col-md-12 col-lg-10 col-xl-8">
          <article>
            <h1>{{ page.title }}</h1>
            {{~ if content ~}}
            <div class="mb-4">{{ content }}</div>
            {{~ end ~}}
            <div class="card-list">
              {{~ seen = {} ~}}
              {{~ for item in list_pages ~}}
              {{~ if item.layout_type != null && item.layout_type != "single"; continue; end ~}}
              {{~ if !(item.url | string.starts_with lang_prefix); continue; end ~}}
              {{~ if item.url == lang_prefix || item.url == (lang_prefix + "index.html"); continue; end ~}}
              {{~# Skip nested list hubs (e.g. /changelog/beta/) ~}}
              {{~ if item.layout_type == "list"; continue; end ~}}
              {{~ if (item.channel ?? "release") != list_channel; continue; end ~}}
              {{~ slug = item.url | string.remove lang_prefix | string.replace "/" "" ~}}
              {{~ if slug == "" || slug == "index.html" || slug == "beta"; continue; end ~}}
              {{~ seen[slug] = true ~}}
              <div class="card">
                <div class="card-body">
                  <h2 class="h3"><a class="stretched-link text-body" href="{{ item.url }}">{{ item.title }}</a></h2>
                </div>
              </div>
              {{~ end ~}}
              {{~ if current_lang != "en" ~}}
              {{~ for item in list_pages ~}}
              {{~ if item.layout_type != null && item.layout_type != "single"; continue; end ~}}
              {{~ if !(item.url | string.starts_with "/changelog/"); continue; end ~}}
              {{~ if item.url == "/changelog/" || item.url == "/changelog/index.html"; continue; end ~}}
              {{~ if item.layout_type == "list"; continue; end ~}}
              {{~ if (item.channel ?? "release") != list_channel; continue; end ~}}
              {{~ slug = item.url | string.remove "/changelog/" | string.replace "/" "" ~}}
              {{~ if slug == "" || slug == "index.html" || slug == "beta"; continue; end ~}}
              {{~ if seen[slug]; continue; end ~}}
              <div class="card">
                <div class="card-body">
                  <h2 class="h3"><a class="stretched-link text-body" href="{{ item.url }}">{{ item.title }}</a></h2>
                </div>
              </div>
              {{~ end ~}}
              {{~ end ~}}
            </div>
          </article>
        </div>
      </div>
    </div>
  </div>
  {{ include "footer/footer" }}
  {{ include "footer/script-footer" }}
  {{ if site.to_top_button }}
  <div class="d-flex fixed-bottom pb-4 pb-lg-5 pe-4 pe-lg-5">
    <a id="toTop" href="#" class="btn btn-outline-primary rounded-circle ms-auto p-2"><span class="visually-hidden">Top</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-up"><polyline points="18 15 12 9 6 15"></polyline></svg></a>
  </div>
  {{ end }}
</body>
</html>
