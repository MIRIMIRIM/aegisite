---
layout: base
---
{{~ include "_i18n-detect" ~}}
<section class="section home-hero container-fluid mt-n3 pb-3">
  <div class="row justify-content-center">
    <div class="text-center">
      <img src="/img/logo-large.png" class="img-fluid" alt="Large Aegisub Logo image" width="500" height="194">
    </div>
    <div class="col-lg-12 text-center">
      <h1 class="mt-0">{{ page.title }}</h1>
    </div>
    <div class="col-lg-14 text-center">
      <p class="lead">{{ page.lead ?? page.description ?? i18n.description }}</p>
      <a class="btn btn-primary btn-lg px-4 mb-2" href="/downloads/" role="button">{{ i18n.strings.get_started ?? "Get Started" }}</a>
      <p class="meta">
        <a href="https://github.com/AmusementClub/Aegisub/blob/master/LICENCE">{{ i18n.strings.bsd_license ?? "Open-source BSD-style licenses." }}</a>
        <a href="https://github.com/AmusementClub/Aegisub">GitHub v{{ site.data.version.current }}</a>
      </p>
    </div>
  </div>
</section>
{{ content }}
