<footer class="footer text-muted">
  <div class="container-{{ site.full_width ? "fluid" : "xxl" }}">
    <div class="row">
      <div class="col-lg-8 order-last order-lg-first">
        <ul class="list-inline">
          <li class="list-inline-item">{{ i18n.footer }}</li>
        </ul>
      </div>
      <div class="col-lg-8 order-first order-lg-last text-lg-end">
        <ul class="list-inline">
          {{~ if current_menu != null && current_menu.footer != null ~}}
            {{~ for item in current_menu.footer ~}}
              <li class="list-inline-item"><a href="{{ site_href item.url }}">{{ item.name }}</a></li>
            {{~ end ~}}
          {{~ end ~}}
        </ul>
      </div>
    </div>
  </div>
</footer>
