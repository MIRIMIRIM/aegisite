{{~# Twitter Card meta tags ~}}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="{{ i18n.twitter_site }}">
{{~ if page.twitter_title ~}}
<meta name="twitter:title" content="{{ page.twitter_title }}">
{{~ else ~}}
<meta name="twitter:title" content="{{ page.title }}">
{{~ end ~}}
{{~ if page.twitter_description ~}}
<meta name="twitter:description" content="{{ page.twitter_description }}">
{{~ else ~}}
<meta name="twitter:description" content="{{ page.description ?? i18n.description }}">
{{~ end ~}}
<meta name="twitter:image" content="{{ site_abs (page.twitter_image ?? "/img/logo.png") }}">
