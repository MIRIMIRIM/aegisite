{{~# OpenGraph meta tags ~}}
{{~ public_url = site_path (page.url == "/index.html" ? "/" : page.url) ~}}

{{~ og_image = page.og_image ?? "/img/logo.png" ~}}
{{~ og_locale = i18n.og_locale ~}}
<meta property="og:title" content="{{ page.title }}">
<meta property="og:description" content="{{ page.description ?? i18n.description }}">
<meta property="og:type" content="{{ page.og_type ?? "website" }}">
<meta property="og:url" content="{{ site_abs public_url }}">
<meta property="og:image" content="{{ site_abs og_image }}">
<meta property="og:locale" content="{{ og_locale }}">
{{~ if i18n.title ~}}
<meta property="og:site_name" content="{{ i18n.title }}">
{{~ end ~}}
