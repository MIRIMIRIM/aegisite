{{~# Docs sidebar menu ~}}
{{~ if current_menu != null && current_menu.docs != null ~}}
<ul class="list-unstyled collapsible-sidebar">
  {{~ for section in current_menu.docs ~}}
  <li class="mb-1">
    {{~ active = page.relative_url | string.contains section.identifier ~}}
    <button class="btn btn-toggle align-items-center rounded collapsed" data-bs-toggle="collapse" data-bs-target="#section-{{ section.identifier }}" aria-expanded="{{ active ? "true" : "false" }}">
      {{ section.name }}
    </button>
    {{~ if section.children != null && section.children.size > 0 ~}}
    <div class="collapse{{ active ? " show" : "" }}" id="section-{{ section.identifier }}">
      <ul class="btn-toggle-nav list-unstyled fw-normal pb-1 small">
        {{~ for child in section.children ~}}
        <li><a class="docs-link rounded{{ page.relative_url | string.contains child.url ? " active" : "" }}" href="{{ site_href child.url }}">{{ child.name }}</a></li>
        {{~ end ~}}
      </ul>
    </div>
    {{~ end ~}}
  </li>
  {{~ end ~}}
</ul>
{{~ end ~}}
