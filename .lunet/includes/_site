{{~# Path helpers for basepath (empty local; /aegisite on ghpages) ~}}
{{~ bp = site.basepath ?? "" ~}}
{{~ if bp == "/" ~}}
  {{~ bp = "" ~}}
{{~ end ~}}
{{~ func site_path(p) ~}}
  {{~ if p == null || p == "" ~}}
    {{~ ret "/" ~}}
  {{~ end ~}}
  {{~ if (p | string.starts_with "http://") || (p | string.starts_with "https://") || (p | string.starts_with "//") || (p | string.starts_with "#") || (p | string.starts_with "mailto:") || (p | string.starts_with "data:") ~}}
    {{~ ret p ~}}
  {{~ end ~}}
  {{~ if !(p | string.starts_with "/") ~}}
    {{~ p = "/" + p ~}}
  {{~ end ~}}
  {{~ if bp != "" && p == bp ~}}
    {{~ ret "/" ~}}
  {{~ end ~}}
  {{~ if bp != "" && (p | string.starts_with bp + "/") ~}}
    {{~ ret p | string.remove bp ~}}
  {{~ end ~}}
  {{~ ret p ~}}
{{~ end ~}}
{{~ func site_href(p) ~}}
  {{~ if p == null || p == "" ~}}
    {{~ ret bp + "/" ~}}
  {{~ end ~}}
  {{~ if (p | string.starts_with "http://") || (p | string.starts_with "https://") || (p | string.starts_with "//") || (p | string.starts_with "#") || (p | string.starts_with "mailto:") || (p | string.starts_with "data:") ~}}
    {{~ ret p ~}}
  {{~ end ~}}
  {{~ p = site_path p ~}}
  {{~ ret bp + p ~}}
{{~ end ~}}
{{~ func site_abs(p) ~}}
  {{~ if p == null || p == "" ~}}
    {{~ p = "/" ~}}
  {{~ end ~}}
  {{~ if (p | string.starts_with "http://") || (p | string.starts_with "https://") ~}}
    {{~ ret p ~}}
  {{~ end ~}}
  {{~ path = site_path p ~}}
  {{~ root = site.baseurl ?? "" ~}}
  {{~ ret root + path ~}}
{{~ end ~}}
